# Environment for the clean CI run. Everything else is removed with env -i.
PATH=/root/.local/bin:/opt/node22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root
LANG=C.UTF-8
TZ=UTC
# Where this machine keeps Playwright's Chromium (GitHub installs it in the default location instead).
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
# Image builds run behind this workspace's TLS-intercepting proxy: the proxy CA is passed only as a build secret.
BUILD_CA=/root/.ccr/ca-bundle.crt
CI_OUT=/var/tmp/axiom-ci-832bf5d-out
# Host-side package downloads also pass through that proxy; its CA is in the system store, so uv uses the system store.
UV_SYSTEM_CERTS=1
